import sys
import time

def jalanin_lirik():
    lirik = [
        ("I miss that kind of misery ", 0.07, 0.1),
        ("The kind where you are nice to me ", 0.06, 0.1),
        ("But only in the evening ", 0.06, 0.1),
        ("So i ask, am i just dreaming? ", 0.07, 0.1),
        ("I love you so much ", 0.054, 0.1),
        ("That's it's dripping ", 0.054, 0.1),
        ("Dripping from my arms and such ", 0.054, 0.1),
        ("I'm sorry i know i'm too much ", 0.054, 0.1),
        ("To love to trust i'm nothing but ", 0.054, 0.4),
        
    ]

    print("\n== Misery - Pupsies ==")
    time.sleep(1.0)

    for baris_lagu, delay_karakter, delay_setelah in lirik:

        # Efek mengetik per karakter
        for karakter in baris_lagu:
            print(karakter, end="")
            sys.stdout.flush()
            time.sleep(delay_karakter)

        # Jeda mengikuti perpindahan nada/lirik
        time.sleep(delay_setelah)
        print("")

    print("// Code by Fanncode")

jalanin_lirik()
